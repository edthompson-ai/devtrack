# Copy to .env and fill in what you need. Never commit .env.

# Database. SQLite works with no setup; docker compose sets a Postgres URL itself.
DATABASE_URL=sqlite:///devtrack.db
# Optional separate read-only login for the question box (Postgres).
# DATABASE_URL_READONLY=postgresql://devtrack_reader:...@localhost:5432/devtrack

# GitHub (only for `devtrack sync`; the seed works offline). A fine-grained token with
# read-only "Contents", "Pull requests" and "Actions" access on public repos is enough.
GITHUB_TOKEN=
GITHUB_REPOS=pallets/click,psf/requests,encode/httpx
# Workflow file that runs the test suite (builds come from its runs). Empty: all workflows.
GITHUB_CI_WORKFLOW=

# AI checker with a real model (optional; the offline heuristic runs without it).
# claude-cli: Claude Code headless (`claude -p`) on a logged-in subscription, no key.
# api: the Messages API; needs ANTHROPIC_API_KEY.
CHECKER_BACKEND=claude-cli
ANTHROPIC_API_KEY=
CHECKER_MODEL=claude-sonnet-5-5
CHECKER_RUN_BUDGET_USD=2.00
# Set these to your actual per-million-token prices; they drive the cost cap.
CHECKER_PRICE_INPUT_PER_MTOK=3.00
CHECKER_PRICE_OUTPUT_PER_MTOK=15.00

# Approved internal model for repositories classified 'controlled' (export-controlled).
# External models are never sent controlled data; this endpoint is the only route.
# The client is a stub in this build: see ApprovedInternalModelClient.
INTERNAL_MODEL_URL=
INTERNAL_MODEL_NAME=internal-approved

# docker compose database passwords (local-only defaults are used if unset)
POSTGRES_PASSWORD=
POSTGRES_READER_PASSWORD=
